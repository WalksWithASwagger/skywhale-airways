# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# Varlock is the agent-readable contract for env names and sensitivity.
# Local values live in ~/.agents/env/values/ and are referenced by path here.
# Vercel Production + Preview keep their own env; do not change those here.
#
# The project values file is imported whole so `npm run dev` can load local
# env through Varlock after the app-local .env symlink is removed on KK's Mac.
# Named .env.skywhale-airways.local to match WalksWithASwagger/skywhale-airways
# (same {repo}.local pattern as .env.rec-os.local).
# @import(~/.agents/env/values/.env.skywhale-airways.local, allowMissing=true)
# @defaultRequired=false @defaultSensitive=false
# ---

# Optional. Retired GitHub Pages subpath build only.
# @public
VITE_BASE_PATH=

# Optional. Absolute base URL used to build sitemap.xml entries.
# Defaults to https://skywhaleairways.com when unset.
# @public
VITE_SITE_URL=

# Optional. GA4 measurement ID. Loads gtag only when a valid G-... or GT-... value is set.
# @public
VITE_GA_MEASUREMENT_ID=

# Optional. Search Console verification meta tag, injected at build time.
# @public
VITE_GOOGLE_SITE_VERIFICATION=

# @public
VITE_SHOPIFY_DOMAIN=

# Storefront token for the embedded Buy Button. Browser-public by design; still treat as sensitive in the contract.
# @sensitive
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# @public
VITE_SHOPIFY_NOMAD_STICKER_PRODUCT_ID=

# @public
VITE_SHOPIFY_NOMAD_PATCH_PRODUCT_ID=

# @public
VITE_SHOPIFY_NOMAD_TEE_PRODUCT_ID=

# Staged products (enabled:false in src/shop-data.js until live).
# @public
VITE_SHOPIFY_CHEST_PATCH_PRODUCT_ID=

# @public
VITE_SHOPIFY_CHEST_DECAL_PRODUCT_ID=

# @public
VITE_SHOPIFY_DECADE_WEATHER_CARD_PRODUCT_ID=

# @public
VITE_SHOPIFY_BAGGAGE_TAG_PRODUCT_ID=

# @public
VITE_SHOPIFY_GRAVITY_STICKER_PRODUCT_ID=

# @public
VITE_SHOPIFY_GRAVITY_TEE_PRODUCT_ID=

# @public
VITE_SHOPIFY_PIN_SET_PRODUCT_ID=

# @public
VITE_SHOPIFY_RELICS_SHEET_PRODUCT_ID=
