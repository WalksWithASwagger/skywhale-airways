# Names-only example. Local values live in
# ~/.agents/env/values/.env.skywhale-airways.local and are imported by path
# from .env.schema. `npm run dev` loads them through `varlock run --inject vars`.
# Do not copy secrets into this repo. Vercel Production + Preview keep their
# own env.

# Optional. Retired GitHub Pages subpath build only.
VITE_BASE_PATH=

VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_SITE_VERIFICATION=
# Optional. Absolute base URL used to build sitemap.xml entries.
# Defaults to https://skywhaleairways.com when unset.
VITE_SITE_URL=
VITE_SHOPIFY_DOMAIN=
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
VITE_SHOPIFY_NOMAD_STICKER_PRODUCT_ID=
VITE_SHOPIFY_NOMAD_PATCH_PRODUCT_ID=
VITE_SHOPIFY_NOMAD_TEE_PRODUCT_ID=
# Staged products (enabled:false in src/shop-data.js until live) — see merch/shopify-launch.md
VITE_SHOPIFY_CHEST_PATCH_PRODUCT_ID=
VITE_SHOPIFY_CHEST_DECAL_PRODUCT_ID=
VITE_SHOPIFY_DECADE_WEATHER_CARD_PRODUCT_ID=
VITE_SHOPIFY_BAGGAGE_TAG_PRODUCT_ID=
VITE_SHOPIFY_GRAVITY_STICKER_PRODUCT_ID=
VITE_SHOPIFY_GRAVITY_TEE_PRODUCT_ID=
VITE_SHOPIFY_PIN_SET_PRODUCT_ID=
VITE_SHOPIFY_RELICS_SHEET_PRODUCT_ID=
