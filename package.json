{
  "name": "skywhale-airways",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "I AM NOMAD — a psychedelic airport for time travelers. WebGL microsite. AI Film Club Retro challenge, June 2026. By Kris Krug & Suzy Easton.",
  "scripts": {
    "dev": "varlock run --inject vars -- vite",
    "build": "vite build",
    "preview": "vite preview",
    "env:validate": "varlock load --agent --show-all",
    "check:seo": "node scripts/check-seo.mjs",
    "test:seo": "node --test tests/seo-check.test.mjs",
    "test:env": "node --test tests/env-contract.test.mjs",
    "optimize": "node scripts/optimize-assets.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "varlock": "^1.21.1",
    "vite": "^8.3.1"
  }
}
