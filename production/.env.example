# Names-only example. Local values live in
# ~/.agents/env/values/.env.skywhale-airways.local and are imported by path
# from .env.schema. Documented pipeline commands load them through
# `varlock run --inject vars`. Do not copy secrets into this repo.

# Replicate — Veo 3.1 clips (720p/1080p), stable-audio music beds, Demucs stems, Whisper
REPLICATE_API_TOKEN=

# Gemini API — Veo 3.1 4K clips (Replicate doesn't expose 4k); GEMINI_API_KEY also accepted
GOOGLE_API_KEY=

# Legacy Gemini alias accepted by the pipeline
GEMINI_API_KEY=

# ElevenLabs — voiceover synthesis
ELEVENLABS_API_KEY=

# Used by Rafiki card generation invoked from this production workspace
OPENAI_API_KEY=
